// Документ Приходная накладная - Модуль объекта
// Автоматическое проведение по регистрам

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Включаем запись движений по регистрам
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ВзаиморасчетыСКонтрагентами.Записывать = Истина;
	Движения.ЦеныНоменклатуры.Записывать = Истина;
	
	СуммаДокумента = 0;
	
	Для Каждого СтрТовар Из Товары Цикл
		
		// 1. Движение по регистру накопления ОстаткиТоваров (Приход)
		ДвижениеОстатки = Движения.ОстаткиТоваров.ДобавитьПриход();
		ДвижениеОстатки.Период = Дата;
		ДвижениеОстатки.Склад = Склад;
		ДвижениеОстатки.Номенклатура = СтрТовар.Номенклатура;
		ДвижениеОстатки.Количество = СтрТовар.Количество;
		
		// 2. Движение по регистру сведений ЦеныНоменклатуры (Периодический)
		Если СтрТовар.Цена > 0 Тогда
			ЗаписьЦены = Движения.ЦеныНоменклатуры.Добавить();
			ЗаписьЦены.Период = Дата;
			ЗаписьЦены.Номенклатура = СтрТовар.Номенклатура;
			ЗаписьЦены.Цена = СтрТовар.Цена;
		КонецЕсли;
		
		СуммаДокумента = СуммаДокумента + СтрТовар.Сумма;
		
	КонецЦикла;
	
	// 3. Движение по регистру накопления ВзаиморасчетыСКонтрагентами (Приход долга перед поставщиком)
	Если СуммаДокумента > 0 Тогда
		ДвижениеВзаиморасчеты = Движения.ВзаиморасчетыСКонтрагентами.ДобавитьПриход();
		ДвижениеВзаиморасчеты.Период = Дата;
		ДвижениеВзаиморасчеты.Организация = Организация;
		ДвижениеВзаиморасчеты.Контрагент = Поставщик;
		ДвижениеВзаиморасчеты.Сумма = СуммаДокумента;
	КонецЕсли;
	
КонецПроцедуры
