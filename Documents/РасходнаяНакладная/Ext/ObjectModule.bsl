// Документ Расходная накладная - Модуль объекта
// Проведение с контролем остатков и фиксацией продаж

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	Движения.ВзаиморасчетыСКонтрагентами.Записывать = Истина;
	
	СуммаДокумента = 0;
	
	Для Каждого СтрТовар Из Товары Цикл
		
		// 1. Движение по остаткам (Расход со склада)
		ДвижениеОстатки = Движения.ОстаткиТоваров.ДобавитьРасход();
		ДвижениеОстатки.Период = Дата;
		ДвижениеОстатки.Склад = Склад;
		ДвижениеОстатки.Номенклатура = СтрТовар.Номенклатура;
		ДвижениеОстатки.Количество = СтрТовар.Количество;
		
		// 2. Движение по регистру оборотов Продажи (Выручка и себестоимость)
		ДвижениеПродажи = Движения.Продажи.Добавить();
		ДвижениеПродажи.Период = Дата;
		ДвижениеПродажи.Номенклатура = СтрТовар.Номенклатура;
		ДвижениеПродажи.Контрагент = Покупатель;
		ДвижениеПродажи.Количество = СтрТовар.Количество;
		ДвижениеПродажи.СуммаВыручки = СтрТовар.Сумма;
		ДвижениеПродажи.Себестоимость = СтрТовар.Себестоимость;
		
		СуммаДокумента = СуммаДокумента + СтрТовар.Сумма;
		
	КонецЦикла;
	
	// 3. Движение по взаиморасчетам (Расход - возникновение дебиторской задолженности покупателя)
	Если СуммаДокумента > 0 Тогда
		ДвижениеВзаиморасчеты = Движения.ВзаиморасчетыСКонтрагентами.ДобавитьРасход();
		ДвижениеВзаиморасчеты.Период = Дата;
		ДвижениеВзаиморасчеты.Организация = Организация;
		ДвижениеВзаиморасчеты.Контрагент = Покупатель;
		ДвижениеВзаиморасчеты.Сумма = СуммаДокумента;
	КонецЕсли;
	
КонецПроцедуры
