// Документ Поступление денег - Модуль объекта
// Проведение по кассе/счету и закрытие задолженности

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ДвиженияДенежныхСредств.Записывать = Истина;
	Движения.ВзаиморасчетыСКонтрагентами.Записывать = Истина;
	
	// 1. Увеличение денежных средств
	ДвижениеДенег = Движения.ДвиженияДенежныхСредств.Добавить();
	ДвижениеДенег.Период = Дата;
	ДвижениеДенег.СтатьяДвижения = СтатьяДвижения;
	ДвижениеДенег.Сумма = СуммаДокумента;
	
	// 2. Погашение дебиторской задолженности покупателя (Приход закрывает расход)
	ДвижениеВзаиморасчеты = Движения.ВзаиморасчетыСКонтрагентами.ДобавитьПриход();
	ДвижениеВзаиморасчеты.Период = Дата;
	ДвижениеВзаиморасчеты.Организация = Организация;
	ДвижениеВзаиморасчеты.Контрагент = Контрагент;
	ДвижениеВзаиморасчеты.Сумма = СуммаДокумента;
	
КонецПроцедуры
